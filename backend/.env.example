# Copy to backend/.env. Never commit .env (it is git-ignored).

# Brief generation chain, tried left to right; the local playbook is always the final fallback.
#   ollama  - local model via Ollama (default, works offline)
#   gemini  - optional cloud tier; needs GEMINI_API_KEY
LLM_PROVIDERS=ollama
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
LLM_TIMEOUT_S=60

# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

MAX_UPLOAD_MB=300
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
